{
  "name": "proyecto-test",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para proyecto universitario con React, .NET 9 y MongoDB",
  "scripts": {
    "dev": "pnpm --filter @proyectoTest/web dev",
    "dev:backend": "cd apps/backend && dotnet run",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}

